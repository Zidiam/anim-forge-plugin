--[[
	Redeeming a credit code.

	A code is credits with no owner attached: nothing is bound to it until
	someone types it in here, which is what lets one be handed to a friend. The
	account these headers name is the account the credits land on, so the whole
	feature is this box — read the code, hand it to the server, say plainly what
	came back.

	The server is the authority on whether a code is real and grants it exactly
	once. This side must therefore never guess an outcome, and never retry on its
	own: an optimistic "added!" that the server refused would be a lie about
	someone's balance.

	Scoped so its locals cost the main chunk no registers (see the note at the
	top of the Settings page) — nothing outside this block needs any of them.
]]
do
	local redeemCard = card(settingsPage, 5)
	caption(redeemCard, "Redeem a code", 1)

	local redeemText = Instance.new("TextLabel")
	redeemText.Size = UDim2.new(1, 0, 0, 0)
	redeemText.AutomaticSize = Enum.AutomaticSize.Y
	redeemText.BackgroundTransparency = 1
	redeemText.Font = Enum.Font.SourceSans
	redeemText.TextSize = 13
	redeemText.TextXAlignment = Enum.TextXAlignment.Left
	redeemText.TextWrapped = true
	redeemText.TextColor3 = C.dim
	redeemText.Text = "Have a code? Paste it here. A credit code tops up your balance; a plan code turns your monthly allowance on — you only ever paste that one once."
	redeemText.LayoutOrder = 2
	redeemText.Parent = redeemCard

	-- Code font, because a code is read character by character when it is being
	-- checked against whatever it was copied from, and l/1 and O/0 have to differ.
	local redeemBox = Instance.new("TextBox")
	redeemBox.Size = UDim2.new(1, 0, 0, 28)
	redeemBox.BackgroundColor3 = C.field
	redeemBox.BorderSizePixel = 0
	redeemBox.Font = Enum.Font.Code
	redeemBox.TextSize = 13
	redeemBox.TextColor3 = C.text
	redeemBox.PlaceholderText = "AF-XXXX-XXXX"
	redeemBox.PlaceholderColor3 = C.dim
	redeemBox.TextXAlignment = Enum.TextXAlignment.Left
	redeemBox.ClearTextOnFocus = false
	redeemBox.Text = ""
	redeemBox.LayoutOrder = 3
	corner(redeemBox)
	do
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 8)
		pad.Parent = redeemBox
	end
	redeemBox.Parent = redeemCard

	-- Below the button, matching the card above: the outcome appears where the
	-- eye already is after pressing, and the instructions never move.
	local redeemStatus = Instance.new("TextLabel")
	redeemStatus.Size = UDim2.new(1, 0, 0, 0)
	redeemStatus.AutomaticSize = Enum.AutomaticSize.Y
	redeemStatus.BackgroundTransparency = 1
	redeemStatus.Font = Enum.Font.SourceSans
	redeemStatus.TextSize = 12
	redeemStatus.TextXAlignment = Enum.TextXAlignment.Left
	redeemStatus.TextWrapped = true
	redeemStatus.TextColor3 = C.dim
	redeemStatus.Text = ""
	redeemStatus.LayoutOrder = 5
	redeemStatus.Parent = redeemCard

	local redeemButton, setRedeemText = actionButton(redeemCard, {
		icon = "check",
		fallback = "✓",
		text = "Redeem",
		bg = C.accent,
		fg = C.onAccent,
		height = 30,
		textSize = 14,
		iconSize = 14,
		layoutOrder = 4,
	})

	local redeeming = false
	local function doRedeem()
		-- One in flight at a time. Two presses would be two grant attempts for one
		-- code, and the second comes back "already used" — the server is right and
		-- the user would be staring at a failure for a code that just worked.
		if redeeming then
			return
		end
		-- Strip every space, not just the ends: codes get read aloud and retyped in
		-- groups, and the check for "typed nothing yet" has to be honest about a box
		-- holding only blanks. Case and hyphens are the server's to normalize.
		local code = (redeemBox.Text:gsub("%s", ""))
		if code == "" then
			redeemStatus.TextColor3 = C.warn
			redeemStatus.Text = "Enter a code first."
			return
		end
		redeeming = true
		setRedeemText("Redeeming…")
		redeemStatus.TextColor3 = C.dim
		redeemStatus.Text = ""
		task.spawn(function()
			local res, err, detail = api.redeem(code)
			setRedeemText("Redeem")
			redeeming = false
			if res and res.ok == true then
				-- A spent code is dead. Clearing the box removes the obvious second
				-- press, which would return "already used" and read as though the
				-- first press had not worked.
				redeemBox.Text = ""
				local n = tonumber(res.credits) or 0
				redeemStatus.TextColor3 = C.good
				redeemStatus.Text = ("✓  Added %s credit%s."):format(fmtCredits(n), n == 1 and "" or "s")
				-- The pill is the number people actually watch; make it agree.
				refreshEntitlement()
				return
			end
			-- The two refusals a person can act on get plain language. Anything else
			-- is the server's own message, which knows more than this side does.
			redeemStatus.TextColor3 = C.bad
			local reason = type(detail) == "table" and detail.error or nil
			if reason == "CODE_UNKNOWN" then
				redeemStatus.Text = "That code isn't valid — check for typos."
			elseif reason == "CODE_USED" then
				redeemStatus.Text = "That code has already been used."
			else
				redeemStatus.Text = tostring(err or "Could not redeem that code right now.")
			end
		end)
	end

	redeemButton.MouseButton1Click:Connect(doRedeem)
	-- Enter submits: the box is the only field on the card, and after pasting a
	-- code the hand is already on the keyboard.
	redeemBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			doRedeem()
		end
	end)
end

