--- Credits come in halves, so 0.5 must survive and 3 must not print as "3.0".
local function fmtCredits(n)
	n = tonumber(n) or 0
	if n == math.floor(n) then
		return tostring(math.floor(n))
	end
	return tostring(n)
end
