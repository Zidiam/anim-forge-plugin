local function corner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = inst
end

local function stroke(inst, color)
	local s = Instance.new("UIStroke")
	s.Color = color or C.stroke
	s.Thickness = 1
	s.Parent = inst
	return s
end

--- Icon-or-glyph: ImageLabel (tinted upload) when synced, TextLabel fallback glyph
--- otherwise. Caller sets Size/Position/AnchorPoint on the returned instance.
local function glyph(parent, iconName, fallbackText, color, textSize)
	local inst
	if ICON[iconName] then
		inst = Instance.new("ImageLabel")
		inst.Image = ICON[iconName]
		inst.ImageColor3 = color or C.text
		inst.ScaleType = Enum.ScaleType.Fit
	else
		inst = Instance.new("TextLabel")
		inst.Font = Enum.Font.SourceSansBold
		inst.Text = fallbackText
		inst.TextSize = textSize or 16
		inst.TextColor3 = color or C.text
	end
	inst.BackgroundTransparency = 1
	inst.Parent = parent
	return inst
end

local function tintGlyph(inst, color)
	if inst:IsA("ImageLabel") then
		inst.ImageColor3 = color
	else
		inst.TextColor3 = color
	end
end

