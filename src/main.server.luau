renameButton.MouseButton1Click:Connect(function()
	if not editSelected or not selectedRig then
		return
	end
	local newName = renameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	local ok, err = Install.rename(selectedRig.model, editSelected.name, newName)
