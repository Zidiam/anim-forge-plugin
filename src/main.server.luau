---------------------------------------------------------------- job flow
--[[
	One card per generation, each running its own poll loop.

	Nothing here is shared global state any more: a generation carries its own
	rig, its own progress, its own cancel handle and its own result. That is what
	lets three of them run side by side without the second one stomping the
	first's animation before the user has installed it.
]]

local SPIN = { "◐", "◓", "◑", "◒" }

-- activeJobs / pendingInstalls / maxConcurrent are declared near the top so the
-- entitlement refresh can read and feed them; see the forward declarations there.
local jobSeq = 0

--[[
	A job card belongs to ONE conversation and is only ever shown there.

	Killing the cards on "+ New chat" orphaned the poll loops behind them; leaving
	them on screen was worse in a different way — a blank new chat still showed the
	previous animation generating, with a prompt box under it, which is not a new
	chat at all. So the card stays alive and simply belongs elsewhere: hidden here,
	waiting in its own room, and visible meanwhile as a live row in History.

	A card whose job has not been named yet has no root to match on, so it is
	tracked by the epoch it was submitted in — it belongs to the room the user was
	standing in when they sent it.
]]
function syncJobCards()
	for _, c in ipairs(jobListFrame:GetChildren()) do
		if not c:IsA("UIListLayout") then
			local root = c:GetAttribute("afRoot")
			local epoch = c:GetAttribute("afEpoch")
			c.Visible = if root ~= nil
				then root == currentChatRoot
				else epoch == chatEpoch
		end
	end
end

--- How many generations are actually still working. A cancelled one is on its
--- way out and must not hold a slot the user could be using.
local function runningCount()
	local n = 0
	for _, job in pairs(activeJobs) do
		if not job.cancelled then
			n += 1
		end
	end
	return n
end

--- Is this conversation waiting on a generation of its own?
function chatIsBusy()
	if (submitting[roomKey(currentChatRoot, chatEpoch)] or 0) > 0 then
		return true -- this room has a message the server has not answered yet
	end
	if chatStarted and not currentChatRoot then
		return true -- the opening generation, not yet named
	end
	for _, job in pairs(activeJobs) do
		if not job.cancelled and job.rootId == currentChatRoot then
			return true
		end
	end
	return false
end

--[[
	Keep the composer honest about what it will do right now.

	While this chat is generating, it accepts nothing: you are editing an animation
	that does not exist yet, and letting a second message through would either
	queue against a version that never arrives or quietly fork a new one. Every
	chat client behaves this way: the composer waits for the reply.

	Other chats are unaffected: only THIS conversation is blocked, so a generation
	running elsewhere never stops you starting one here.
]]
function renderGenerateButton()
	local busy = chatIsBusy()
	local n = runningCount()
	local atLimit = n >= maxConcurrent
	local blocked = busy or atLimit or outOfCredits

	generateButton.AutoButtonColor = not blocked
	generateButton.BackgroundColor3 = if blocked then C.accentDim else C.accent
	promptBox.TextEditable = not busy
	promptBox.PlaceholderText = if busy
		then "Waiting for this animation to finish…"
		elseif chatStarted then "Describe the next change to this animation…"
		else 'e.g. "heavy zombie lunge attack" or "cheerful wave with a bounce"'

	local verb = if chatStarted then "Send" else "Generate"
	if outOfCredits and not busy then
		setGenerateText("Out of credits — see Settings")
	elseif busy then
		setGenerateText("Generating…")
	elseif atLimit then
		setGenerateText(("%d running — wait for one"):format(n))
	elseif n == 0 then
		setGenerateText(verb)
	else
		setGenerateText(("%s  ·  %d running"):format(verb, n))
	end
end

--[[
	Build a card for one generation and return the handle its poll loop drives.

	The card owns every widget it needs, so tearing it down is one Destroy and
	there is no shared state to reset.
]]
local function makeJobCard(promptText)
	jobSeq += 1
	local holder = card(jobListFrame, -jobSeq) -- negative order = newest on top

	local titleRow = Instance.new("Frame")
	titleRow.Size = UDim2.new(1, 0, 0, 18)
	titleRow.BackgroundTransparency = 1
	titleRow.LayoutOrder = 1
	titleRow.Parent = holder

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -26, 1, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.SourceSansBold
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.TextColor3 = C.text
	title.Text = promptText
	title.Parent = titleRow

	-- one button that means "stop this" while running and "clear this" after
	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0.5)
	closeButton.Position = UDim2.new(1, 0, 0.5, 0)
	closeButton.Size = UDim2.new(0, 20, 0, 18)
	closeButton.BackgroundTransparency = 1
	closeButton.Font = Enum.Font.SourceSansBold
	closeButton.TextSize = 15
	closeButton.TextColor3 = C.dim
	closeButton.Text = "✕"
	closeButton.AutoButtonColor = true
	closeButton.Parent = titleRow

	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, 0, 0, 0)
	status.AutomaticSize = Enum.AutomaticSize.Y
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.SourceSans
	status.TextSize = 13
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextWrapped = true
	status.TextColor3 = C.dim
	status.Text = "Starting…"
	status.LayoutOrder = 2
	status.Parent = holder

	local barBack = Instance.new("Frame")
	barBack.Size = UDim2.new(1, 0, 0, 5)
	barBack.BackgroundColor3 = C.bg
	barBack.BorderSizePixel = 0
	barBack.LayoutOrder = 3
	corner(barBack, 3)
	barBack.Parent = holder

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.new(0.05, 0, 1, 0)
	barFill.BackgroundColor3 = C.accent
	barFill.BorderSizePixel = 0
	corner(barFill, 3)
	barFill.Parent = barBack

	-- everything below only appears once the generation succeeds
	-- Preview first: seeing the character move is the moment that sells the product,
	-- and it should happen right here, not after leaving for the Animation Editor.
	local previewButton, setPreviewText = actionButton(holder, {
		icon = "sparkle",
		fallback = "▶",
		text = "Preview",
		bg = C.field,
		fg = C.text,
		height = 30,
		textSize = 14,
		iconSize = 14,
		strokeIt = true,
		layoutOrder = 4,
	})
	previewButton.Visible = false

	local installButton = actionButton(holder, {
		icon = "download",
		fallback = "⬇",
		text = "Install onto rig",
		bg = C.good,
		fg = Color3.fromRGB(16, 26, 18),
		height = 32,
		textSize = 15,
		layoutOrder = 5,
	})
	installButton.Visible = false

	-- The bake engine's actual findings, rendered as tappable rows: proof a real
	-- engine measured the clip (the most "high-tech" artifact the product makes),
	-- and one tap pre-fills a refine so the box is never a blank page. Populated in
	-- the done handler from job.validate.
	local findingsFrame = Instance.new("Frame")
	findingsFrame.Size = UDim2.new(1, 0, 0, 0)
	findingsFrame.AutomaticSize = Enum.AutomaticSize.Y
	findingsFrame.BackgroundTransparency = 1
	findingsFrame.Visible = false
	findingsFrame.LayoutOrder = 6
	findingsFrame.Parent = holder
	do
		local fl = Instance.new("UIListLayout")
		fl.Padding = UDim.new(0, 3)
		fl.SortOrder = Enum.SortOrder.LayoutOrder
		fl.Parent = findingsFrame
	end

	local critiqueBox = Instance.new("TextBox")
	critiqueBox.Size = UDim2.new(1, 0, 0, 38)
	critiqueBox.BackgroundColor3 = C.field
	critiqueBox.BorderSizePixel = 0
	critiqueBox.Font = Enum.Font.SourceSans
	critiqueBox.TextSize = 13
	critiqueBox.TextColor3 = C.text
	critiqueBox.PlaceholderText = 'Want changes? e.g. "bigger wind-up"'
	critiqueBox.PlaceholderColor3 = C.dim
	critiqueBox.TextXAlignment = Enum.TextXAlignment.Left
	critiqueBox.TextYAlignment = Enum.TextYAlignment.Top
	critiqueBox.ClearTextOnFocus = false
	critiqueBox.MultiLine = true
	critiqueBox.TextWrapped = true
	critiqueBox.Text = ""
	critiqueBox.Visible = false
	critiqueBox.LayoutOrder = 7
	corner(critiqueBox)
	critiqueBox.Parent = holder
	do
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 4)
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
