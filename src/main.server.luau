		checking = true
		setCheckText("Checking…")
		status.Text = ""
		task.spawn(function()
			local res, err = api.linkConfirm()
			setCheckText("Check my profile")
			checking = false
			if res and res.ok == true then
				status.Text = tostring(res.message or "Verified.")
				status.TextColor3 = C.good
				codeBox.Visible = false
