--[[
	Live progress rows.

	A generation takes a couple of minutes, and during that time you might be
	looking at History, or at a different chat, or you might have started three at
	once. So the in-flight jobs are tracked here and rendered wherever they are
	relevant — as a row at the top of History, and as a pending entry in the tree
	of the chat they belong to — each with its stage and how long it has been
	running.

	Rows register themselves and are updated in place rather than rebuilt, so a
	list does not flicker every two seconds.
]]
local liveRows = {} -- { jobId, status, barFill, frame }

--[[
	A progress row, and the guaranteed way back to the generation behind it.

	Cards live in one conversation, so navigating away from a generation hides its
	card — and if the user moved during the request, the room it ends up in may not
	be one they can reach yet (a chat with no finished versions is not in History).
	That left a running job with no progress, no cancel and no result. This row is
	the answer: it is always listed, clicking it opens that conversation, and it
	carries its own cancel so a job can be stopped without finding its card first.
]]
local function makeLiveRow(parent, order, jobId, label)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, 42)
	row.BackgroundColor3 = C.field
	row.BorderSizePixel = 0
	row.Text = ""
	row.AutoButtonColor = true
	row.LayoutOrder = order
	corner(row, 6)
	stroke(row, C.accentDim)
	row.Parent = parent

	-- open the conversation this generation belongs to; read the root at CLICK
	-- time, because a brand-new chat is only named once the server replies
	row.MouseButton1Click:Connect(function()
		local job = activeJobs[jobId]
		if job and job.rootId and openChatDetail then
			selectTab("Chat")
			openChatDetail(job.rootId)
		else
			setMessage("This one is still starting — it'll open in a moment.", C.dim)
		end
	end)

	local stopBtn = Instance.new("TextButton")
	stopBtn.AnchorPoint = Vector2.new(1, 0)
	stopBtn.Position = UDim2.new(1, -8, 0, 4)
	stopBtn.Size = UDim2.new(0, 20, 0, 18)
	stopBtn.BackgroundTransparency = 1
	stopBtn.Font = Enum.Font.SourceSansBold
	stopBtn.TextSize = 15
	stopBtn.TextColor3 = C.dim
	stopBtn.Text = "✕"
	stopBtn.AutoButtonColor = true
	stopBtn.Parent = row
	stopBtn.MouseButton1Click:Connect(function()
		local job = activeJobs[jobId]
		if job and not job.cancelled then
			job.cancelled = true
			task.spawn(function()
				api.cancel(jobId)
			end)
			setMessage("Stopping that generation — no credits used.", C.dim)
		end
	end)

	local title = Instance.new("TextLabel")
	title.Position = UDim2.new(0, 9, 0, 4)
	title.Size = UDim2.new(1, -34, 0, 15)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.SourceSansBold
	title.TextSize = 13
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.TextColor3 = C.text
	title.Text = tostring(label)
	title.Parent = row

	local status = Instance.new("TextLabel")
	status.Position = UDim2.new(0, 9, 0, 18)
	status.Size = UDim2.new(1, -18, 0, 14)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.SourceSans
	status.TextSize = 12
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextTruncate = Enum.TextTruncate.AtEnd
	status.TextColor3 = C.dim
	status.Text = "Starting…"
	status.Parent = row

	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.new(0, 9, 1, -8)
	barBack.Size = UDim2.new(1, -18, 0, 4)
	barBack.BackgroundColor3 = C.bg
	barBack.BorderSizePixel = 0
	corner(barBack, 2)
	barBack.Parent = row

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.new(0.05, 0, 1, 0)
	barFill.BackgroundColor3 = C.accent
	barFill.BorderSizePixel = 0
	corner(barFill, 2)
	barFill.Parent = barBack

	table.insert(liveRows, { jobId = jobId, status = status, barFill = barFill, frame = row })
	return row
end

--- Repaint every registered row from its job's current state, and drop the rows
--- whose job has finished.
local function refreshLiveRows()
	for i = #liveRows, 1, -1 do
		local r = liveRows[i]
		local job = activeJobs[r.jobId]
		if not job or not r.frame.Parent then
			table.remove(liveRows, i)
		else
			local stage = STAGES[job.stage or "queued"] or STAGES.queued
			r.status.Text = ("%s…   %ds"):format(stage.text, math.floor(os.clock() - (job.startedAt or os.clock())))
			r.barFill.Size = UDim2.new(math.max(job.progress or 0.05, stage.frac), 0, 1, 0)
		end
	end
end

--- Jobs still running, oldest first, optionally only those in one chat.
local function liveJobsFor(rootId)
	local out = {}
	for jobId, job in pairs(activeJobs) do
		if not rootId or job.rootId == rootId then
			table.insert(out, { jobId = jobId, job = job })
		end
	end
	table.sort(out, function(a, b)
		return (a.job.startedAt or 0) < (b.job.startedAt or 0)
	end)
	return out
end

