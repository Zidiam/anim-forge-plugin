-- Entitlement refreshes on tab switches and job events, never on a timer. The
-- likeliest posture right after topping up in the experience is sitting right
-- here waiting for the number to move, so the button polls for the change and
-- flips the UI itself — bounded, and it stops the moment it lands so it never
-- runs long.
local creditPollActive = false
local function pollForCreditChange()
	if creditPollActive then
		return
	end
	creditPollActive = true
	task.spawn(function()
		local base = api.entitlement()
		local baseTier = base and base.tier
		local baseCredits = base and tonumber(base.credits) or 0
		local deadline = os.clock() + 300 -- give up after 5 minutes
		while os.clock() < deadline do
			task.wait(10)
			local ent = api.entitlement()
			if ent then
				-- Credits are what a pack moves. A tier is never sold — support
				-- can set one by hand — so that branch just states the new state
				-- rather than reading like a receipt.
				local tierChanged = ent.tier ~= baseTier
				local creditsChanged = (tonumber(ent.credits) or 0) ~= baseCredits
				if tierChanged or creditsChanged then
					refreshEntitlement()
					getMoreStatus.TextColor3 = C.good
					getMoreStatus.Text = creditsChanged and "✓  Credits added — you're all set."
						or ("✓  Your account is set to %s now."):format(tostring(ent.tier))
					break
				end
			end
		end
		creditPollActive = false
	end)
end

