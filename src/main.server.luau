--- Icon + text action button. Returns button, setText, setColors.
local function actionButton(parent, opts)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, opts.height or 36)
	b.BackgroundColor3 = opts.bg or C.field
	b.BorderSizePixel = 0
	b.Text = ""
	b.AutoButtonColor = true
	b.LayoutOrder = opts.layoutOrder or 0
	corner(b)
	if opts.strokeIt then
		stroke(b)
	end
	b.Parent = parent

	local row = Instance.new("Frame")
	row.Size = UDim2.fromScale(1, 1)
	row.BackgroundTransparency = 1
	row.Parent = b
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Padding = UDim.new(0, 7)
	l.Parent = row

	local ic
	if opts.icon or opts.fallback then
		ic = glyph(row, opts.icon, opts.fallback, opts.fg or C.text, opts.textSize or 16)
		ic.Size = UDim2.new(0, opts.iconSize or 17, 0, opts.iconSize or 17)
		ic.LayoutOrder = 1
	end

	local t = Instance.new("TextLabel")
	t.AutomaticSize = Enum.AutomaticSize.X
	t.Size = UDim2.new(0, 0, 1, 0)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.SourceSansBold
	t.TextSize = opts.textSize or 16
	t.TextColor3 = opts.fg or C.text
	t.Text = opts.text
	t.LayoutOrder = 2
	t.Parent = row

	return b, function(newText)
		t.Text = newText
	end, function(color)
		t.TextColor3 = color
		if ic then
			tintGlyph(ic, color)
		end
	end
end

