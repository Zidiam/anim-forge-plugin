	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 30)
	btn.BackgroundColor3 = C.field
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = true
	btn.LayoutOrder = 1
	corner(btn)
	btn.Parent = container

	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 9, 0, 0)
	label.Size = UDim2.new(1, -30, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.TextColor3 = C.dim
	label.Text = placeholder
	label.Parent = btn

	local chev = Instance.new("TextLabel")
	chev.AnchorPoint = Vector2.new(1, 0)
	chev.Position = UDim2.new(1, -8, 0, 0)
	chev.Size = UDim2.new(0, 16, 1, 0)
	chev.BackgroundTransparency = 1
	chev.Font = Enum.Font.SourceSansBold
	chev.TextSize = 13
	chev.TextColor3 = C.dim
	chev.Text = "▾"
	chev.Parent = btn

	local list = Instance.new("Frame")
	list.Size = UDim2.new(1, 0, 0, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.BackgroundColor3 = C.bg
	list.BorderSizePixel = 0
	list.Visible = false
	list.LayoutOrder = 2
	corner(list)
	stroke(list)
	list.Parent = container
	local ll = Instance.new("UIListLayout")
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = list

	local dd = { onPick = nil, open = false, container = container }

	function dd.hide()
		container.Visible = false
	end

	function dd.setText(text, isPlaceholder)
		label.Text = text
		label.TextColor3 = isPlaceholder and C.dim or C.text
	end

	function dd.close()
		dd.open = false
		list.Visible = false
		chev.Text = "▾"
	end

	function dd.setItems(names)
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		for i, name in ipairs(names) do
			local item = Instance.new("TextButton")
			item.Size = UDim2.new(1, 0, 0, 26)
			item.BackgroundColor3 = C.bg
			item.BorderSizePixel = 0
			item.Font = Enum.Font.SourceSans
			item.TextSize = 14
			item.TextColor3 = C.text
			item.TextXAlignment = Enum.TextXAlignment.Left
			item.TextTruncate = Enum.TextTruncate.AtEnd
			item.Text = "   " .. name
			item.AutoButtonColor = true
			item.LayoutOrder = i
			item.Parent = list
			item.MouseButton1Click:Connect(function()
				dd.close()
				dd.setText(name, false)
				if dd.onPick then
					dd.onPick(name)
				end
			end)
		end
	end

	btn.MouseButton1Click:Connect(function()
		dd.open = not dd.open
		list.Visible = dd.open
		chev.Text = dd.open and "▴" or "▾"
	end)

	return dd
end

