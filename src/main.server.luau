---------------------------------------------------------------- icon registry
-- icons.luau is generated by Asphalt (named after the [inputs.icons] table);
-- harvest every string leaf keyed by its basename so flat and nested both work.
local ICON = {}
do
	local mod = script.Parent:FindFirstChild("icons") or script.Parent:FindFirstChild("assets")
	if mod then
		local ok, tbl = pcall(require, mod)
		if ok and type(tbl) == "table" then
			local function harvest(t)
				for k, v in pairs(t) do
					if type(v) == "table" then
						harvest(v)
					elseif type(v) == "string" then
						local name = tostring(k):gsub("%.png$", ""):match("([^/\\]+)$")
						if name then
							ICON[name] = v
						end
					end
				end
			end
			harvest(tbl)
		end
	end
end

