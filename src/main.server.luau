			meta.BackgroundTransparency = 1
			meta.Font = Enum.Font.SourceSans
			meta.TextSize = 11
			meta.TextXAlignment = Enum.TextXAlignment.Left
			meta.TextColor3 = C.dim
			local nv = tonumber(item.versions) or 1
			meta.Text = ("%d version%s  ·  %s%s"):format(
				nv,
				nv == 1 and "" or "s",
				os.date("%b %d", math.floor((item.createdAt or 0) / 1000)),
				item.installed and "  ·  installed" or ""
