--- Where the store is and what it sells, as the server reports it.
---
--- `packs` absent means selling is switched off server-side — that is a
--- different state from "the list is empty", and both render as nothing here on
--- purpose: a price list the server will not honour is worse than no price list.
function setStoreInfo(store)
	if type(store) ~= "table" then
		return
	end
	if type(store.url) == "string" and store.url ~= "" then
		storeBox.Text = store.url
	end
	-- Monthly plans. Same contract as packs: the server owns every figure, and a
	-- missing list means "not sold" rather than "empty list".
	local planLines = {}
	if type(store.plans) == "table" then
		for _, plan in ipairs(store.plans) do
			local n = type(plan) == "table" and tonumber(plan.credits) or nil
			if n and type(plan.priceText) == "string" and type(plan.tier) == "string" then
				local name = plan.tier:sub(1, 1):upper() .. plan.tier:sub(2)
				table.insert(
					planLines,
					("%s  ·  %s a month  ·  %s"):format(name, fmtCredits(n), plan.priceText)
				)
			end
		end
	end
	if #planLines > 0 then
		plansText.Text = "MONTHLY PLANS — the allowance resets each month\n" .. table.concat(planLines, "\n")
	end
	plansText.Visible = #planLines > 0

	local packs = store.packs
	if type(packs) ~= "table" then
		packsText.Visible = false
		return
	end
	local lines = {}
	for _, pack in ipairs(packs) do
		-- Every field is checked before it is read: this is decoded JSON off the
		-- wire, and one malformed entry throwing here would take down the whole
		-- entitlement refresh — the quota pill included — over a price list.
		local n = type(pack) == "table" and tonumber(pack.credits) or nil
		-- priceText is pre-formatted by the server (currency included): this side
		-- must never do money arithmetic or pick a currency symbol of its own.
		if n and type(pack.priceText) == "string" then
			table.insert(lines, ("%s credit%s  ·  %s"):format(fmtCredits(n), n == 1 and "" or "s", pack.priceText))
		end
	end
	if #lines > 0 then
		packsText.Text = (#planLines > 0 and "CREDIT PACKS — never expire\n" or "") .. table.concat(lines, "\n")
	end
	packsText.Visible = #lines > 0
end

