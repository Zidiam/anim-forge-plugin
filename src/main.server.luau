--- Hide the whole product behind the update notice (or restore it).
function applyUpdateLock(locked)
	if locked == updateLocked then
		return
	end
	updateLocked = locked
	updateCard.Visible = locked
	-- consent comes first: never reveal the tabs just because the version is fine
	local blocked = locked or not consentDone
	tabBar.Visible = not blocked
	consentCard.Visible = not consentDone and not locked
	for _, page in pairs(pages) do
		page.Visible = (not blocked) and (page.Name == activeTab .. "Page")
	end
	if locked then
		messageLabel.Text = ""
		local latest = api.latestVersion
		updateBody.Text = ("You're running v%s.%s Anim Forge can't generate until it's updated."):format(
			Version.VERSION,
			latest and (" The current version is v" .. tostring(latest) .. ".") or ""
		)
	end
end
end

---------------------------------------------------------------- entitlement (quota display)
local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

local function fmtReset(iso)
	local _, m, d = tostring(iso or ""):match("^(%d+)-(%d+)-(%d+)")
	if not m then
		return nil
	end
	return ("%s %d"):format(MONTHS[tonumber(m)] or "?", tonumber(d))
end

local entBusy = false
-- How many consecutive offline reads we've seen — drives "waking" vs "offline".
local offlineAttempts = 0
-- Guards the reconnect backoff loop so only one runs at a time.
local connectWatchRunning = false
function refreshEntitlement()
	if entBusy then
		return
	end
	entBusy = true
	task.spawn(function()
		local ent = api.entitlement()
		entBusy = false
		if not ent then
			-- A Railway container cold-starting is the normal first impression, not an
			-- outage: for the first several seconds call it "waking", not "offline", so
			-- a first-time installer doesn't see a permanently-broken plugin and leave.
			offlineAttempts += 1
			local waking = offlineAttempts <= 4
			connLabel.Text = waking and "● waking…" or "● server offline"
			connLabel.TextColor3 = waking and C.warn or C.bad
			quotaText.Text = waking and "Waking the server — one moment…"
				or "Server offline — generations unavailable"
			quotaText.TextColor3 = C.dim
			accountText.Text = waking and "The server sleeps when idle; cold starts take a few seconds."
				or "Server not reachable — check your connection and try again."
			return
		end
		offlineAttempts = 0
		connLabel.Text = "● connected"
		connLabel.TextColor3 = C.good

		-- the server decides; the UI just reflects it
		local compat = ent.client
		applyUpdateLock(type(compat) == "table" and compat.updateRequired == true)
		-- Above the early return on purpose: the update screen is the ONE surface
		-- that still matters to a locked-out install, and the address it tells
		-- people to download from is the server's to name. Below the return it
		-- would only ever be set for builds that don't need it.
		if type(ent.store) == "table" then
			setStoreInfo(ent.store)
			setUpdateUrl(ent.store.url)
		end
		-- A newer build exists but this one still works. Said once, quietly, and
		-- dismissible: nobody installed this by hand to be nagged, and the
		-- alternative to mentioning it now is the hard lockout arriving later
		-- with no warning.
		if type(compat) == "table" and compat.updateAvailable == true and setUpdateNudge then
			setUpdateNudge(compat.latestVersion)
		end
		if updateLocked then
			return
		end
		-- how many generations may run at once is the server's call
		maxConcurrent = math.max(1, tonumber(ent.maxConcurrent) or maxConcurrent)
		if applyQualityCosts then
			applyQualityCosts(ent.qualityCosts)
		end
		if renderGenerateButton then
			renderGenerateButton()
		end

		local left = tonumber(ent.generationsLeft) or 0
		local credits = tonumber(ent.credits) or 0
		local reset = fmtReset(ent.resetsAt)
		local subParts = {}
		if left >= 0 and reset then
			table.insert(subParts, "resets " .. reset)
		end
		if credits > 0 then
			table.insert(subParts, ("+%s banked"):format(fmtCredits(credits)))
		end
		quotaSub.Text = table.concat(subParts, "  ·  ")
		-- Credits are the single unit the whole product counts in: whatever the
		-- account's tier still covers plus anything banked from packs. Showing one
		-- total is the honest answer to "how many animations can I make right now".
		local total = left < 0 and -1 or (left + credits)
		if total < 0 then
			quotaText.Text = "Unlimited credits"
			quotaText.TextColor3 = C.text
			tintGlyph(quotaIcon, C.accent)
		elseif total == 0 then
			quotaText.Text = "0 credits left"
			quotaText.TextColor3 = C.bad
			tintGlyph(quotaIcon, C.bad)
		else
			quotaText.Text = ("%s credit%s left"):format(fmtCredits(total), total == 1 and "" or "s")
			quotaText.TextColor3 = C.text
			tintGlyph(quotaIcon, (left + credits) <= 3 and C.warn or C.accent)
		end

		-- Let the size picker grey out what this balance can't cover. A single
		-- generation draws from the tier balance OR banked credits, never split
		-- across both, so the most one can spend is the LARGER pool — not the summed
		-- total the pill shows. Using the sum would mark a size affordable that the
		-- server then refuses (e.g. 0.5 from the tier + 1.5 banked can't fund a
		-- 2-credit Best).
		affordableCredits = left < 0 and -1 or math.max(left, credits)
		if renderQuality then
			renderQuality()
		end

		-- What the account has, in credits. Nobody buys a tier — support can set
		-- one by hand for a comp or a fix — so the tier's name is only worth
		-- printing when there is one; everyone else just wants the number.
		local accountLine
		if total < 0 then
			accountLine = "Unlimited credits."
		else
			accountLine = ("%s credit%s left."):format(fmtCredits(total), total == 1 and "" or "s")
			if left > 0 and reset then
				accountLine = accountLine
					.. (
						credits > 0 and (" %s of them reset %s."):format(fmtCredits(left), reset)
						or (" Resets %s."):format(reset)
					)
			end
			if credits > 0 then
				accountLine = accountLine
					.. ("\n%s credit%s came from packs — those never expire."):format(
						fmtCredits(credits),
						credits == 1 and "" or "s"
					)
			end
		end
		if ent.tier and ent.tier ~= "trial" then
			accountLine = ("Account: %s\n"):format(tostring(ent.tier)) .. accountLine
		end
		local freeEdits = tonumber(ent.freeEditsPerAnimation) or 0
		if freeEdits > 0 then
			accountLine = accountLine
				.. ("\nEditing an animation you made is free for its first %d edits."):format(freeEdits)
		end
		accountText.Text = accountLine

		-- Paywall: free generation spent (per user or per IP) and nothing banked →
		-- only Settings remains, with the way to get more credits front and center.
		--
		-- EXCEPT while a finished generation is still sitting there uninstalled.
		-- Metering happens on success, so the entitlement refresh that FOLLOWS a
		-- successful free generation reports zero left — paywalling on that would
		-- hide the Home tab, and the result card with it, the very instant the
		-- animation the user waited two minutes for finally appeared. They would
		-- never get to install the thing the free trial exists to sell them on.
		-- Out of credits is a reason to stop GENERATING, not a reason to take the
		-- product away. Hiding the tabs used to fire the moment a free user's first
		-- animation finished — auto-install had already spent the credit — dumping
		-- them in Settings with their new animation off screen. The server refuses
		-- the next generation regardless; the UI just has to be honest about why.
		local paywalled = ent.tier == "trial" and left == 0 and credits == 0
		outOfCredits = paywalled
		tabButtons.Chat.button.Visible = true
		tabButtons.History.button.Visible = true

		-- Where to get more credits. The server owns the experience URL, so it
		-- can move without a plugin release.
		if type(ent.getMore) == "table" then
			setGameUrl(ent.getMore.gameUrl)
		end

		-- Another install already holds this account's link: surface the proof
		-- card now, before a generation bounces off the spend gate.
		local link = ent.accountLink
		if type(link) == "table" and link.bound == true and link.thisInstall == false then
			maybeOfferLink()
		end
	end)
end

---------------------------------------------------------------- animation controls logic
--- Paint the controls for whichever installed animation the chat is pointing at.
--- Hidden unless the user asked for them: most of the time you want the animation,
--- not its timing controls.
function renderEditOptions()
	deleteArmed = false
	delButton.Text = "Delete"
	if not editSelected or not tweakOpen then
		animCard.Visible = false
		optionsFrame.Visible = false
		return
	end
	local kfs = editSelected.kfs
	animCard.Visible = true
	optionsFrame.Visible = true
	local dur = Install.durationOf(kfs)
	infoLabel.Text = ("%.2fs · %s · %s"):format(
		dur,
		kfs.Loop and "loops" or "one-shot",
		tostring(kfs.Priority.Name)
	)
	tweakTitle.Text = "TWEAK  ·  " .. string.upper(tostring(editSelected.name))
	setLoopText(kfs.Loop and "Loop: on" or "Loop: off")
	prioDrop.setText(tostring(kfs.Priority.Name), false)
	renameBox.Text = editSelected.name
end

local function refreshAnimList(keepName)
	editAnims = {}
	if not selectedRig or not selectedRig.model.Parent then
		animDrop.setItems({})
		animDrop.setText("Select a character first…", true)
		editSelected = nil
		renderEditOptions()
		return
	end
	local list = Install.listAnimations(selectedRig.model)
	local names = {}
	for _, entry in ipairs(list) do
		editAnims[entry.name] = entry
		table.insert(names, entry.name)
	end
	animDrop.setItems(names)
	if keepName and editAnims[keepName] then
		editSelected = editAnims[keepName]
		animDrop.setText(keepName, false)
	else
		editSelected = nil
		animDrop.setText(#names == 0 and "No saved animations on this rig yet" or "Select an animation…", true)
	end
	renderEditOptions()
end

animDrop.onPick = function(name)
	editSelected = editAnims[name]
	renderEditOptions()
end

--- Offer the rig's existing animations as a starting point — but only while
--- this is a new chat. Inside an open chat the subject is already decided.
function refreshSourceList()
	sourceSelected = nil
	sourceAnims = {}
	local usable = selectedRig ~= nil and selectedRig.model.Parent ~= nil and not chatStarted
	if not usable then
		sourceCaption.Visible = false
		sourceDrop.container.Visible = false
		return
	end
	local names = { NEW_ANIMATION_LABEL }
	for _, entry in ipairs(Install.listAnimations(selectedRig.model)) do
		sourceAnims[entry.name] = entry
		table.insert(names, entry.name)
	end
	-- nothing to start from: don't show an empty control
	if #names == 1 then
		sourceCaption.Visible = false
		sourceDrop.container.Visible = false
		return
	end
	sourceDrop.setItems(names)
	sourceDrop.setText(NEW_ANIMATION_LABEL, true)
	sourceCaption.Visible = true
	sourceDrop.container.Visible = true
end

sourceDrop.onPick = function(name)
	sourceSelected = if name == NEW_ANIMATION_LABEL then nil else sourceAnims[name]
	sourceDrop.setText(name, sourceSelected == nil)
	promptBox.PlaceholderText = if sourceSelected
		then ('What should change about "%s"?'):format(name)
		else 'e.g. "heavy zombie lunge attack" or "cheerful wave with a bounce"'
end

onRigSelected = function()
	-- the controls follow the rig: a different character has different animations
	refreshAnimList(editSelected and editSelected.name or nil)
	refreshSourceList()
end

loopButton.MouseButton1Click:Connect(function()
	if not editSelected or not selectedRig then
		return
	end
	Install.setLoop(selectedRig.model, editSelected.name, not editSelected.kfs.Loop)
	renderEditOptions()
end)

prioDrop.onPick = function(prioName)
	if not editSelected or not selectedRig then
		return
	end
	Install.setPriority(selectedRig.model, editSelected.name, prioName)
	renderEditOptions()
end

