	end
end)

dupButton.MouseButton1Click:Connect(function()
	if not editSelected or not selectedRig then
		return
	end
	local copyName, err = Install.duplicate(selectedRig.model, editSelected.name)
	if copyName then
		setMessage(('✓  Duplicated as "%s".'):format(copyName), C.good)
		refreshAnimList(copyName)
	else
		setMessage("Duplicate failed: " .. tostring(err), C.bad)
	end
end)

delButton.MouseButton1Click:Connect(function()
	if not editSelected or not selectedRig then
		return
	end
	if not deleteArmed then
		deleteArmed = true
		delButton.Text = "Really delete?"
		task.delay(3, function()
			deleteArmed = false
			delButton.Text = "Delete"
		end)
		return
	end
	local name = editSelected.name
	Install.delete(selectedRig.model, name)
	setMessage(('✓  Deleted "%s".'):format(name), C.good)
	refreshAnimList(nil)
end)

---------------------------------------------------------------- HISTORY tab logic
local busyChat = false
local openChat = nil -- rootId of the conversation being viewed
local chatSelected = nil -- the message a reply will branch from
local chatVersions = {} -- jobId -> version row, for the open chat

local buildChats -- fwd decl
local resetChatPath -- fwd decl (the job flow shows the newest branch on completion)
local buildChatsIfVisible -- fwd decl (the job flow refreshes History)

--- Put a specific version of an animation onto the selected rig.
local function installVersion(jobId, label)
	if busyChat then
		return
	end
	if not selectedRig or not selectedRig.model.Parent then
		setMessage("Pick a character first — installing needs a rig to install onto.", C.bad)
		return
	end
	setMessage(('Fetching "%s"…'):format(tostring(label)))
	busyChat = true
	local rigModel = selectedRig.model
	local rigType = selectedRig.rigType
	task.spawn(function()
		local job, jerr = api.job(jobId)
		busyChat = false
		if not job or job.status ~= "done" or not job.densePoses then
			setMessage("Couldn't fetch that version: " .. tostring(jerr or "not found"), C.bad)
			return
		end
		if (job.densePoses.rigType or "R15") ~= rigType then
			setMessage(
				('"%s" was made for a different rig type than %s — select a matching character first.'):format(
					tostring(label),
					rigModel.Name
				),
				C.warn
			)
			return
		end
		local kfs, ierr = Install.install(rigModel, job.densePoses, { jobId = jobId })
		if kfs then
			setMessage(('✓  Installed "%s" onto %s.'):format(kfs.Name, rigModel.Name), C.good)
			refreshAnimList(kfs.Name) -- its controls appear right below the tree
		else
			setMessage("Install failed: " .. tostring(ierr), C.bad)
		end
	end)
end

-- Did the USER pick the message the composer is aimed at, or did we default to
-- the end of the line? Only a deliberate pick is worth preserving when a new
-- version lands. Declared HERE, above its first assignment: while it lived
-- below selectChatMessage, that assignment created a global instead, the
-- readers went on testing a local that was never set, and clicking a message
-- to branch from it silently snapped back to the newest one.
local chatSelectedByUser = false

--- Which message a reply continues from. Selecting a message is how you branch:
--- reply to the newest and the chat continues, reply to an older one and a new
--- branch grows from there.
local function selectChatMessage(jobId)
	chatSelected = jobId
	chatSelectedByUser = true
	local v = chatVersions[jobId]
	chatReplyLabel.Text = v and ("Editing v%d — your change branches from here"):format(v.version or 1) or ""
	if openChat then
		openChatDetail(openChat, true)
	end
end

--- Render one message pair: what was asked for, and what came back.
--[[
	The conversation, as a conversation.

	Edits genuinely branch — regenerate from an older message and you get a
	sibling, not a replacement — but showing that as an indented tree makes people
	read a chat as a filesystem. Every chat tool worth copying solves this the same
	way: show ONE path top to bottom, and where a message has siblings, put a small
	‹ 1/3 › on it to walk between them. The branch is still there; it just is not
	in your face until it matters.

	`pathChoice[parentJobId] = jobId` remembers which sibling to follow, so walking
	back and regenerating swaps the rest of the transcript to that branch — the old
	continuation is not deleted, it is simply not the path you are on.
]]
local pathChoice = {} -- parentJobId (or "" for roots) -> chosen child jobId

--- Forget which branches were being viewed. Called when a new version lands and
--- when a different chat opens: a fresh result should be what you see, not a
--- branch you were reading three minutes ago.
function resetChatPath()
	pathChoice = {}
	chatSelected = nil
	chatSelectedByUser = false
end

--- Children of a node, oldest first. "" is the virtual parent of the roots.
local function childrenOf(byParent, key)
	return byParent[key] or {}
end

--- The single line of messages currently on screen, root to leaf.
local function activePath(byParent)
	local path, key = {}, ""
	while true do
		local kids = childrenOf(byParent, key)
		if #kids == 0 then
			return path
		end
		local chosen = kids[#kids] -- newest by default, like every chat client
		for _, k in ipairs(kids) do
			if k.jobId == pathChoice[key] then
				chosen = k
			end
		end
		table.insert(path, { node = chosen, siblings = kids, parentKey = key })
		key = chosen.jobId
	end
end

--- One exchange: what you asked, and what came back.
local function addChatMessage(entry, order, isLeaf, onRerender)
	local v = entry.node
	local siblings = entry.siblings
	local selected = chatSelected == v.jobId

	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, 62)
	row.BackgroundColor3 = if selected then C.field else C.bg
	row.BorderSizePixel = 0
	row.Text = ""
	row.AutoButtonColor = true
	row.LayoutOrder = order
	corner(row, 6)
	if selected then
		stroke(row, C.accent)
	elseif isLeaf then
		stroke(row, C.accentDim)
	end
	row.Parent = chatTreeFrame

	-- your side of the exchange
	local ask = Instance.new("TextLabel")
	ask.Position = UDim2.new(0, 10, 0, 5)
	ask.Size = UDim2.new(1, -80, 0, 16)
	ask.BackgroundTransparency = 1
	ask.Font = Enum.Font.SourceSans
	ask.TextSize = 13
	ask.TextXAlignment = Enum.TextXAlignment.Left
	ask.TextTruncate = Enum.TextTruncate.AtEnd
	ask.TextColor3 = C.dim
	ask.Text = "You:  " .. tostring(v.request ~= "" and v.request or "(no description)")
	ask.Parent = row

	-- and what it made
	local reply = Instance.new("TextLabel")
	reply.Position = UDim2.new(0, 10, 0, 22)
	reply.Size = UDim2.new(1, -80, 0, 18)
	reply.BackgroundTransparency = 1
	reply.Font = Enum.Font.SourceSansBold
	reply.TextSize = 14
	reply.TextXAlignment = Enum.TextXAlignment.Left
	reply.TextTruncate = Enum.TextTruncate.AtEnd
	reply.TextColor3 = C.text
	reply.Text = tostring(v.name or "Animation") .. (v.free and "   ·  free edit" or "")
	reply.Parent = row

	local meta = Instance.new("TextLabel")
	meta.Position = UDim2.new(0, 10, 0, 41)
	meta.Size = UDim2.new(1, -80, 0, 14)
	meta.BackgroundTransparency = 1
	meta.Font = Enum.Font.SourceSans
	meta.TextSize = 11
	meta.TextXAlignment = Enum.TextXAlignment.Left
	meta.TextColor3 = C.dim
	meta.Text = os.date("%b %d, %H:%M", math.floor((v.createdAt or 0) / 1000))
		.. (v.installed and "  ·  installed" or "")
		.. (isLeaf and "  ·  latest" or "")
	meta.Parent = row

	-- Sibling stepper. Only appears where a choice actually exists, so a chat that
	-- was never branched shows none of this.
	if #siblings > 1 then
		local index = 1
		for i, s in ipairs(siblings) do
			if s.jobId == v.jobId then
				index = i
			end
		end

		local function stepper(symbol, dx, delta)
			local b = Instance.new("TextButton")
			b.AnchorPoint = Vector2.new(1, 0)
			b.Position = UDim2.new(1, dx, 0, 5)
			b.Size = UDim2.new(0, 16, 0, 16)
			b.BackgroundTransparency = 1
			b.Font = Enum.Font.SourceSansBold
			b.TextSize = 15
			b.Text = symbol
			b.AutoButtonColor = false
			local target = siblings[index + delta]
			b.TextColor3 = if target then C.accent else C.stroke
			b.Parent = row
			if target then
				b.MouseButton1Click:Connect(function()
					-- follow this sibling; everything after it comes from its branch
					pathChoice[entry.parentKey] = target.jobId
					chatSelected = target.jobId
					chatSelectedByUser = true
					onRerender()
				end)
			end
			return b
		end
		stepper("‹", -46, -1)
		stepper("›", -10, 1)

		local count = Instance.new("TextLabel")
		count.AnchorPoint = Vector2.new(1, 0)
		count.Position = UDim2.new(1, -26, 0, 5)
		count.Size = UDim2.new(0, 24, 0, 16)
		count.BackgroundTransparency = 1
		count.Font = Enum.Font.SourceSans
		count.TextSize = 11
		count.TextColor3 = C.dim
		count.Text = ("%d/%d"):format(index, #siblings)
		count.Parent = row
	end

	local installBtn = Instance.new("TextButton")
	installBtn.AnchorPoint = Vector2.new(1, 1)
	installBtn.Position = UDim2.new(1, -10, 1, -6)
	installBtn.Size = UDim2.new(0, 58, 0, 22)
	installBtn.BackgroundColor3 = C.field
	installBtn.BorderSizePixel = 0
	installBtn.Font = Enum.Font.SourceSansBold
	installBtn.TextSize = 12
	installBtn.TextColor3 = C.good
	installBtn.Text = "Install"
	installBtn.AutoButtonColor = true
	corner(installBtn, 5)
	stroke(installBtn)
	installBtn.Parent = row
	installBtn.MouseButton1Click:Connect(function()
		installVersion(v.jobId, v.name or "animation")
	end)

	-- Timing controls, for the version actually sitting on the rig. Offered per
	-- message and opened on request: most of the time you want the animation, not
	-- its loop/priority/speed knobs. (The transcript rewrite dropped this button,
	-- which left tweakOpen permanently false and the whole panel unreachable.)
	if selectedRig and selectedRig.model.Parent and editAnims[v.name] then
		local tweakBtn = Instance.new("TextButton")
		tweakBtn.AnchorPoint = Vector2.new(1, 1)
		tweakBtn.Position = UDim2.new(1, -74, 1, -6)
		tweakBtn.Size = UDim2.new(0, 52, 0, 22)
		tweakBtn.BackgroundColor3 = C.field
		tweakBtn.BorderSizePixel = 0
		tweakBtn.Font = Enum.Font.SourceSansBold
		tweakBtn.TextSize = 12
		tweakBtn.TextColor3 = C.text
		tweakBtn.Text = "Tweak"
		tweakBtn.AutoButtonColor = true
		corner(tweakBtn, 5)
		stroke(tweakBtn)
		tweakBtn.Parent = row
		tweakBtn.MouseButton1Click:Connect(function()
			tweakOpen = true
			refreshAnimList(v.name)
		end)
	end

	-- clicking the message aims the composer at it: your next send continues here
	row.MouseButton1Click:Connect(function()
		selectChatMessage(v.jobId)
	end)
end

--- Load a conversation into the Chat tab: its title, its tree, its free edits.
--- `stay` keeps the current tab (used when a new version lands in a chat you are
--- already sitting in).
function openChatDetail(rootId, stay)
	-- `stay` marks a self-re-render (a version landed, a branch was stepped).
	-- Only a real navigation invalidates other jobs' claims on the room.
	if not stay then
		chatEpoch += 1
	end
	-- A fetch that is already running for a different chat must not paint into
	-- this one when it returns.
	local myEpoch = chatEpoch
	openChat = rootId
	-- Enter the room NOW, not when the fetch returns. openChat and currentChatRoot
	-- diverging for the length of a network round-trip meant the composer was
	-- still aimed at the previous conversation, and the previous conversation's
	-- job cards were still on screen, while this one was loading.
	if not stay then
		setChatContext(rootId, nil)
	end
	chatTreeCard.Visible = true
	for _, c in ipairs(chatTreeFrame:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	if not stay then
		chatTitle.Text = "Loading…"
		selectTab("Chat")
	end

	task.spawn(function()
		local res, lerr = api.lineage(rootId)
		-- moved on while this was in flight: drop it entirely rather than
		-- interleaving two conversations into one transcript
		if chatEpoch ~= myEpoch then
			return
		end
		if not res or not res.versions then
			-- nothing to show: fold the card away rather than leaving an error
			-- sitting in the middle of an otherwise working Chat tab
			chatTreeCard.Visible = false
			if #liveJobsFor(rootId) == 0 then
				setMessage("Couldn't open that chat: " .. tostring(lerr or "no response"), C.warn)
			end
			return
		end
		chatVersions = {}
		for _, v in ipairs(res.versions) do
			chatVersions[v.jobId] = v
		end
		local newest = res.versions[#res.versions]
		local waiting = #liveJobsFor(rootId) > 0
		chatTitle.Text = if newest
			then tostring(newest.name)
			elseif waiting then "Generating…"
			else "Animation"
		-- the composer now talks to this conversation
		setChatContext(rootId, newest and newest.name or nil)

		-- if this chat's animation is on the selected rig, its controls appear
		refreshAnimList(newest and newest.name or nil)

		local left = tonumber(res.freeEditsLeft) or 0
		-- Deliberately does NOT name a number: a paid edit costs whatever the
		-- size picker is set to (0.5 / 1 / 2), and the user can change that
		-- after reading this line. Promising "1 credit" was wrong for two of
		-- the three sizes.
		chatFreeLabel.Text = left > 0
				and ("%d free edit%s left on this animation, then each one costs the same as a new animation at the size you pick"):format(
					left,
					left == 1 and "" or "s"
				)
			or "Free edits used — each further edit costs the same as a new animation at the size you pick"
		chatFreeLabel.TextColor3 = if left > 0 then C.good else C.dim
		-- default the reply target to the newest message
		if not chatSelectedByUser or not chatVersions[chatSelected] then
			chatSelected = newest and newest.jobId or nil
			chatReplyLabel.Text = newest
					and ("Editing v%d — your change branches from here"):format(newest.version or 1)
				or ""
		end

		-- Walk the real parent links so branches render as branches. Anything
		-- whose parent isn't in this chat is treated as a root.
		-- group by parent ("" holds the openers) so siblings sit together
		local byParent = {}
		for _, v in ipairs(res.versions) do
			local key = (v.parentJobId and chatVersions[v.parentJobId]) and v.parentJobId or ""
			byParent[key] = byParent[key] or {}
			table.insert(byParent[key], v)
		end

		local path = activePath(byParent)
		for i, entry in ipairs(path) do
			addChatMessage(entry, i, i == #path, function()
				openChatDetail(rootId, true)
			end)
		end
		-- the composer continues from the end of the visible line unless you
		-- deliberately clicked further up it
		-- The end of the visible line is where the next message goes, unless the
		-- user deliberately clicked further up it.
		local leaf = path[#path] and path[#path].node
		if leaf and (not chatSelectedByUser or not chatVersions[chatSelected]) then
			chatSelected = leaf.jobId
		end
		local aimed = chatVersions[chatSelected] or leaf
		if aimed then
			chatReplyLabel.Text = ("Your next message continues from v%d"):format(aimed.version or 1)
		end

		-- The generation in progress is NOT drawn here: its card sits directly
		-- below this transcript, which is already the place it will occupy.
	end)
end

--- The list of conversations. Each row identifies itself without being opened.
--- Rebuild the History list only when the user is actually looking at it.
function buildChatsIfVisible()
	if activeTab == "History" then
		buildChats()
