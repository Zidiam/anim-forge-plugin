end

function buildChats()
	for _, c in ipairs(chatListFrame:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	chatsHint.Text = "Loading your chats…"

	task.spawn(function()
		local res = api.history()
		if not res or not res.items then
			chatsHint.Text = "Couldn't load your chats — check the server connection."
			return
		end
		-- Anything generating right now goes at the top — BEFORE the empty check,
		-- because a first-ever generation has no finished chat to be listed under and
		-- would otherwise be invisible everywhere.
		local live = liveJobsFor(nil)
		for i, entry in ipairs(live) do
