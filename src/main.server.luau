		height = 28,
		textSize = 14,
		iconSize = 14,
		strokeIt = true,
		layoutOrder = 8,
	})
	refineButton.Visible = false

	local retryButton = actionButton(holder, {
		icon = "refine",
		fallback = "↻",
		text = "Try again",
		bg = C.field,
		fg = C.text,
		height = 28,
		textSize = 14,
		iconSize = 14,
		strokeIt = true,
		layoutOrder = 9,
	})
	retryButton.Visible = false

	return {
		holder = holder,
		title = title,
		status = status,
		barFill = barFill,
		barBack = barBack,
		closeButton = closeButton,
		previewButton = previewButton,
		setPreviewText = setPreviewText,
		installButton = installButton,
		findingsFrame = findingsFrame,
		critiqueBox = critiqueBox,
		refineButton = refineButton,
		setRefineText = setRefineText,
		retryButton = retryButton,
		progress = 0.05,
		destroy = function()
			holder:Destroy()
		end,
	}
end

--[[
	Run one generation.

	opts: { prompt, previousClip?, critique?, parentJobId? }
	The result installs itself onto the rig as soon as it lands, under the name the
	server composed for it: <original>_<whatYouAskedFor>_v<N>.
]]
function runJob(opts)
	composerRefuse("") -- clear any prior refusal; the guards below re-raise if needed
	local prompt = (opts.prompt or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if prompt == "" then
		composerRefuse("Type what you want animated first.")
		return
	end
	-- Greying the button is not a gate: it was still clickable, and the send went
	-- out to be refused by the server. Refuse it here, where we already know.
	if outOfCredits then
		-- Take them straight to where the fix is rather than naming Settings and
		-- making them go find it.
		setMessage("You're out of credits — Settings has the link to get more.", C.bad)
		selectTab("Settings")
		return
	end
	if runningCount() >= maxConcurrent then
		composerRefuse(
			("You already have %d generations running — one has to finish first."):format(maxConcurrent),
			C.warn
		)
		return
	end

	local jobRig = selectedRig and selectedRig.model
	if not jobRig or not jobRig.Parent then
		selectedRig = nil
		renderSlots("empty")
		composerRefuse("Pick a character first — click the box at the top, then click your rig.")
		return
	end
	-- re-validate: the model may have been unrigged/edited since it was selected
	local stillValid, invalidReason = resolveRig(jobRig)
	if not stillValid then
		composerRefuse(invalidReason or "That model can't be animated anymore — select it again.")
		return
	end
	local okRead, httpOn = pcall(function()
		return HttpService.HttpEnabled
	end)
	if okRead and httpOn == false then
		composerRefuse(
			"HTTP requests are disabled for this place. Turn on Game Settings → Security → Allow HTTP Requests, then try again."
		)
		return
	end
	local desc, derr = Descriptor.describe(jobRig)
	if not desc then
		composerRefuse("Rig problem: " .. tostring(derr))
		return
	end

	-- this generation's rig is captured NOW; the user is free to select another
	-- one for the next generation while this is still running
	-- Point of no return: every refusal is above this line. From here a job is
	-- definitely starting, so the chat stops being a new one immediately — before
	-- the server has named it.
	local wasFirstMessage = not chatStarted
	local submitEpoch = chatEpoch -- the room this message was sent from
	local submitRoot = currentChatRoot
	-- Freeze the chosen size NOW: the request is sent and watched on a background
	-- task, and the user can change the picker while it runs — without this, the
	-- size actually sent (and the deadline we wait) would follow the live selection.
	local submitModel = model
	local submitKey = roomKey(submitRoot, submitEpoch)
	chatStarted = true
	submitting[submitKey] = (submitting[submitKey] or 0) + 1
	setChatContext(submitRoot, nil)

	local ui = makeJobCard(if opts.critique then ('Change: "%s"'):format(opts.critique) else prompt)
	ui.holder:SetAttribute("afRunning", true)
	-- whose conversation this card belongs to; the root is filled in once the
	-- server says which lineage the job joined
	ui.holder:SetAttribute("afEpoch", submitEpoch)
	if submitRoot then
		ui.holder:SetAttribute("afRoot", submitRoot)
	end
	setMessage("")
	renderGenerateButton()

	task.spawn(function()
		local t0 = os.clock()
		local spin = 0
		local currentStage = "queued"
		local jobId = nil
		local jobRoot = nil -- the chat this generation belongs to
		local settled = false
		local cancelBeforeStart = false -- dismissed before the server answered

		--- Leave this card in a terminal state and free the slot.
		local function settle()
			if settled then
				return
			end
			settled = true
			if jobId then
				activeJobs[jobId] = nil
			end
			ui.holder:SetAttribute("afRunning", false) -- sweepable by "+ New chat" now
			renderGenerateButton() -- the chat is free again
			refreshLiveRows()
			buildChatsIfVisible()
			ui.barBack.Visible = false
			ui.closeButton.Text = "✕"
			renderGenerateButton()
		end

		local function fail(text)
			settle() -- releases activeJobs, the card's running flag and the composer
			ui.status.Text = text
			ui.status.TextColor3 = C.bad
			ui.retryButton.Visible = true
			-- The card lives in one conversation. If the user is not in that one,
			-- the failure would be reported to an empty room, so say it out loud.
			if not ui.holder.Visible then
				setMessage(text, C.bad)
			end
			renderGenerateButton()
		end

		ui.closeButton.MouseButton1Click:Connect(function()
			-- Cancelled before the server even named the job: there is nothing to
			-- call yet, so mark the intent and let the poll loop honour it the
			-- moment the id arrives. Without this the request completed into a job
			-- nobody was watching, and settle() could never clear it.
			if not jobId then
				-- nothing to call yet; the poll loop honours this the moment the id
				-- arrives, and the card goes now so it cannot come back as an error
				cancelBeforeStart = true
				settle()
				ui.destroy()
				return
			end
			if jobId and activeJobs[jobId] and not activeJobs[jobId].cancelled then
				-- still running: stop it (and stop it costing anything upstream)
				activeJobs[jobId].cancelled = true
				local id = jobId
				ui.status.Text = "Cancelling…"
				task.spawn(function()
					api.cancel(id)
				end)
				return
			end
			if ui.installButton.Visible then
				-- dismissing an uninstalled result gives up on it
				pendingInstalls = math.max(0, pendingInstalls - 1)
			end
			-- Throwing the card away must stop the work behind it, or the poll loop
			-- carries on and installs an animation the user just discarded.
			if jobId and activeJobs[jobId] then
				activeJobs[jobId].cancelled = true
				local id = jobId
				task.spawn(function()
					api.cancel(id)
				end)
			end
			settle()
			ui.destroy()
			refreshEntitlement()
		end)

		ui.retryButton.MouseButton1Click:Connect(function()
			ui.destroy()
			runJob(opts)
		end)

		local res, err, decoded =
			api.generate(prompt, desc, submitModel, opts.previousClip, opts.critique, opts.parentJobId)
		if not res then
			if decoded and decoded.error == "UPDATE_REQUIRED" then
				applyUpdateLock(true)
				fail("Anim Forge needs updating before you can generate again.")
			elseif decoded and decoded.error == "RATE_LIMITED" then
				fail("Too many generations started just now — wait a minute, then Try again.")
			elseif decoded and decoded.error == "CONCURRENT_JOB" then
				fail("Too many generations running at once — wait for one to finish.")
			elseif decoded and decoded.error == "PROMPT_REJECTED" then
				fail("That description violates the content rules — try describing something else.")
			elseif decoded and decoded.error == "ACCOUNT_LINK_REQUIRED" then
				-- Spend protection: this install has not yet proved it owns the
				-- account whose credits it is about to spend. The fix is the
				-- Settings proof card, so take them straight there with it open.
				fail(tostring(decoded.message or "This install isn't linked to your account yet — link it once in Settings."))
				selectTab("Settings")
				-- maybeOfferLink, not beginLink: asking for a code again REPLACES the
				-- one the server stored, so a second Generate click would silently
				-- invalidate the code the user has already pasted into their profile.
				if maybeOfferLink then
					maybeOfferLink()
				end
			elseif decoded and decoded.error == "QUOTA_EXCEEDED" then
				-- The server says exactly what this size costs and what the caller has;
				-- distinguish "can't afford THIS size" (nudge to a smaller one) from
				-- "nothing left" (send them to the store).
				local cost = tonumber(decoded.cost)
				local leftTotal = (tonumber(decoded.banked) or 0) + (tonumber(decoded.monthlyLeft) or 0)
				if cost and leftTotal > 0 then
					fail(
						("%s needs %s credit%s — you have %s. Try a smaller size, or top up from the Anim Forge experience — link in Settings."):format(
							QUALITY_LABEL[submitModel] or "That size",
							fmtCredits(cost),
							cost == 1 and "" or "s",
							fmtCredits(leftTotal)
						)
					)
				else
					fail("You're out of credits — get more in the Anim Forge experience (link in Settings).")
				end
				refreshEntitlement()
			else
				fail("Couldn't start: " .. tostring(err))
			end
			submitting[submitKey] = math.max(0, (submitting[submitKey] or 1) - 1)
			ui.holder:SetAttribute("afRunning", false)
			-- Nothing was started, so a first message must not strand the composer in
			-- edit mode for a chat that does not exist — but only roll back if the
			-- user is still standing in the room this message was sent from. They may
			-- have opened another chat while this was failing, and blanking THAT is
			-- how a later message silently generated a new animation instead of
			-- editing the one on screen.
			if wasFirstMessage and chatEpoch == submitEpoch then
				chatStarted = false
				setChatContext(nil, nil)
			end
			renderGenerateButton()
			return
		end
		submitting[submitKey] = math.max(0, (submitting[submitKey] or 1) - 1) -- the job marks us busy now
		jobId = res.jobId
		-- everything the History rows and the chat tree need to show this
		-- generation while it runs
		activeJobs[jobId] = {
			cancelled = false,
			rootId = currentChatRoot,
			label = if opts.critique then ('Change: "%s"'):format(opts.critique) else prompt,
			startedAt = t0,
			stage = "queued",
			progress = 0.05,
		}
		-- The server decides which conversation this joined: an edit of an existing
		-- animation belongs to that animation's chat, not to a new one.
		local landedRoot = res.rootId or jobId
		-- Adopt the room ONLY if the user is still in the one this was sent from.
		-- Otherwise a reply arriving after "+ New chat" turned the blank room into
		-- the old conversation, and the next message edited the wrong animation.
		if chatEpoch == submitEpoch and not currentChatRoot then
			setChatContext(landedRoot, prompt)
		end
		activeJobs[jobId].rootId = landedRoot
		jobRoot = landedRoot
		-- now it has a home; show it only in that conversation
		ui.holder:SetAttribute("afRoot", landedRoot)
		syncJobCards()
		renderGenerateButton()
		if cancelBeforeStart then
			-- they gave up while we were waiting; stop it costing anything
			activeJobs[jobId].cancelled = true
			local id = jobId
			task.spawn(function()
				api.cancel(id)
			end)
		end
		-- show the conversation immediately: the tree, with this generation
		-- pending in it, rather than a blank page for the next two minutes
		if chatEpoch == submitEpoch and currentChatRoot then
			task.spawn(function()
				openChatDetail(currentChatRoot, true)
			end)
		end
		buildChatsIfVisible()
		renderGenerateButton()
		if res.freeEdit then
			ui.title.Text = ui.title.Text .. "   (free edit)"
		end

		-- Watch longer for the sizes that legitimately run longer: Best does the
		-- deepest pass (highest effort ≈ several minutes, plus a correction round) and
		-- must not be killed mid-flight, while Quick shouldn't hang for ten minutes.
		-- This only bounds how long the CLIENT waits; the server owns the real cost.
		local DEADLINE = (submitModel == "small" and 5 or submitModel == "max" and 20 or 10) * 60
		local MAX_CONSECUTIVE_FAILURES = 5
		local failures = 0
		-- The server can re-enter an earlier stage to auto-correct its own output.
		-- That is the product's most sophisticated behaviour, but a status that walks
		-- backwards reads as a stall — so once we see the stage regress, say what is
		-- actually happening. peakFrac only rises; fixing latches on.
		local peakFrac, fixing = 0, false
		-- When the current stage started, so the bar can creep within it and the
		-- generation sub-status can rotate.
		local stageStart = os.clock()

		while true do
			for _ = 1, 8 do
				task.wait(0.25)
				spin += 1
				if not settled then
					local elapsedTotal = os.clock() - t0
					local inStage = os.clock() - stageStart
					local label
					if fixing then
						label = "Polishing — the engine found issues and is fixing them automatically"
					elseif currentStage == "generating" then
						-- rotate the sub-status ~every 8s so the long stage reads as work
						label = GENERATING_SUBS[(math.floor(inStage / 8) % #GENERATING_SUBS) + 1]
					else
						label = (STAGES[currentStage] or STAGES.queued).text
					end
					-- Set the expectation early, then drop it once the wait is normal.
					-- Per SIZE, because they are not close: the same "1–3 min" on
					-- Best had people waiting on a number the size cannot hit (its
					-- own deadline below is 20 minutes, not 5).
					local ETA = {
						small = "usually under 2 min",
						mid = "usually 1–3 min",
						max = "usually 4–8 min",
					}
					local suffix = (not fixing and currentStage == "generating" and elapsedTotal < 40)
							and ("   ·   " .. (ETA[submitModel] or ETA.mid))
						or ""
					ui.status.Text =
						("%s  %s…   %ds%s"):format(SPIN[(spin % 4) + 1], label, math.floor(elapsedTotal), suffix)
					-- Creep the bar toward the NEXT stage mark so it is always moving
					-- during the 60-145s generate stage instead of frozen at 55%. It
					-- approaches asymptotically and never crosses the boundary; when the
					-- real stage advances, the poll bumps it the rest of the way.
					local base = (STAGES[currentStage] or STAGES.queued).frac
					local target = NEXT_FRAC[currentStage] or base
					local creep = base + (target - base) * (1 - math.exp(-inStage / 25))
					if creep > ui.progress then
						ui.progress = creep
						ui.barFill.Size = UDim2.new(ui.progress, 0, 1, 0)
					end
					refreshLiveRows() -- History and the tree tick along with the card
				end
			end

			if activeJobs[jobId] and activeJobs[jobId].cancelled then
				settle()
				ui.status.Text = "Cancelled — no credits used."
				ui.status.TextColor3 = C.dim
				ui.retryButton.Visible = true
				return
			end
			if os.clock() - t0 > DEADLINE then
				local id = jobId
				task.spawn(function()
					api.cancel(id)
				end)
				fail("This took too long and was stopped. Nothing was used — try again, or simplify the description.")
				return
			end

			local job, jerr = api.job(jobId)
			if not job then
				-- one blip is not a failure: the job is still running server-side,
				-- and giving up here would abandon a generation the user paid for
				failures += 1
				if failures >= MAX_CONSECUTIVE_FAILURES then
					-- The job is very likely still running and will still be metered;
					-- we have simply stopped being able to watch it. Say that, rather
					-- than implying it was thrown away.
					fail(
						"Lost contact with the server: "
							.. tostring(jerr)
							.. "\nThis generation is probably still running — check History in a minute."
					)
					return
				end
				ui.status.Text = ("◐  Reconnecting… (%d/%d)"):format(failures, MAX_CONSECUTIVE_FAILURES)
				continue
			end
			failures = 0

			if job.status == "running" then
				local nf = (STAGES[job.stage] or STAGES.queued).frac or 0
				if nf + 0.001 < peakFrac then
					fixing = true -- server dropped to an earlier stage: a correction round
				elseif nf > peakFrac then
					peakFrac = nf
				end
				if job.stage ~= currentStage then
					stageStart = os.clock() -- restart the creep and the sub-status rotation
				end
				currentStage = job.stage
				local live = activeJobs[jobId]
				if live then
					live.stage = currentStage
					live.progress = math.max(live.progress or 0, (STAGES[currentStage] or STAGES.queued).frac)
				end
				refreshLiveRows()
				local stage = STAGES[currentStage] or STAGES.queued
				-- the server may re-enter an earlier stage to polish; progress that
				-- jumps backwards reads as a fault, so the bar only advances
				if stage.frac > ui.progress then
					ui.progress = stage.frac
					ui.barFill.Size = UDim2.new(ui.progress, 0, 1, 0)
				end
			elseif job.status == "error" then
				local e = job.error or {}
				local msg = tostring(e.message or "unknown error")
				if e.code == "CANCELLED" then
					settle()
					ui.status.Text = "Cancelled — no credits used."
					ui.status.TextColor3 = C.dim
					ui.retryButton.Visible = true
				else
					fail("✕  " .. tostring(e.code or "ERROR") .. ": " .. msg)
				end
				refreshEntitlement()
				return
			else
				-- Cancelled while this very poll was in flight: the job finished, but
				-- the user already said no. Don't install it and don't claim it as a
				-- result they have to dismiss.
				if activeJobs[jobId] and activeJobs[jobId].cancelled then
					settle()
					ui.status.Text = "Cancelled."
					ui.status.TextColor3 = C.dim
					return
				end
				ui.barFill.Size = UDim2.new(1, 0, 1, 0)
				settle()
				refreshEntitlement() -- metered on success: keep the pill honest

				if not job.densePoses then
					fail("The server finished but returned no animation data. Try again.")
					return
				end

				-- Edit-tab refine: replace the animation in place, no card to click
				-- A finished animation goes onto the rig immediately. Waiting behind an
				-- Install click meant the thing you asked for sat there needing one
				-- more step before you could actually look at it, and a generation
				-- you never installed was work you paid for and never received.
				local errs = 0
				for _, i in ipairs(job.validate or {}) do
					if i.level == "ERROR" then
						errs += 1
					end
				end
				local quality = if errs == 0
					then "quality check clean"
					else (errs .. (errs == 1 and " thing worth refining" or " things worth refining"))
				local shape = ("%.2fs @ %dfps%s"):format(
					tonumber(job.densePoses.duration) or 0,
					tonumber(job.densePoses.fps) or 30,
					job.clip and job.clip.loop and ", loops" or ""
				)
				-- the name the server composed: <original>_<whatYouAskedFor>_v<N>
				local installedName = tostring(job.densePoses.name or (job.clip and job.clip.name) or "clip")
				ui.title.Text = installedName
				ui.critiqueBox.Visible = true
				ui.refineButton.Visible = true
				ui.previewButton.Visible = true

				-- The validator's actual findings, as tappable rows. These are concrete,
				-- measured statements (feet-slide distances, joint-limit violations) — the
				-- smartest thing the product produces, and it used to be collapsed to a
				-- count and thrown away. Tap one to drop it into the refine box.
				do
					for _, ch in ipairs(ui.findingsFrame:GetChildren()) do
						if ch:IsA("TextButton") then
							ch:Destroy()
						end
					end
					local shown = 0
					local ordered = {}
					for _, f in ipairs(job.validate or {}) do
						if type(f) == "table" and f.level == "ERROR" and type(f.text) == "string" then
							table.insert(ordered, f)
						end
					end
					for _, f in ipairs(job.validate or {}) do
						if type(f) == "table" and f.level == "WARN" and type(f.text) == "string" then
							table.insert(ordered, f)
						end
					end
					for _, f in ipairs(ordered) do
						if shown >= 3 then
							break
						end
						shown += 1
						local chip = Instance.new("TextButton")
						chip.Size = UDim2.new(1, 0, 0, 0)
						chip.AutomaticSize = Enum.AutomaticSize.Y
						chip.BackgroundColor3 = C.field
						chip.BorderSizePixel = 0
						chip.Font = Enum.Font.SourceSans
						chip.TextSize = 12
						chip.TextXAlignment = Enum.TextXAlignment.Left
						chip.TextWrapped = true
						chip.TextColor3 = if f.level == "ERROR" then C.warn else C.dim
						chip.Text = "⚑ " .. f.text .. "   ·  tap to refine"
						chip.AutoButtonColor = true
						chip.LayoutOrder = shown
						corner(chip)
						chip.Parent = ui.findingsFrame
						local pad = Instance.new("UIPadding")
						pad.PaddingTop = UDim.new(0, 4)
						pad.PaddingBottom = UDim.new(0, 4)
						pad.PaddingLeft = UDim.new(0, 7)
						pad.PaddingRight = UDim.new(0, 7)
						pad.Parent = chip
						local capture = f.text
						chip.MouseButton1Click:Connect(function()
							ui.critiqueBox.Text = capture
							ui.critiqueBox:CaptureFocus()
						end)
					end
					ui.findingsFrame.Visible = shown > 0
				end

				-- Live preview: play the animation on the rig right here — the moment
				-- that sells the product — without installing anything or leaving for
				-- the Animation Editor. Only one preview runs at a time.
				local myPreview = nil
				local function stopMyPreview()
					if myPreview then
						myPreview.stop()
						if activePreview == myPreview then
							activePreview = nil
						end
						myPreview = nil
					end
					if ui.setPreviewText then
						ui.setPreviewText("Preview")
					end
				end
				ui.holder.Destroying:Connect(stopMyPreview)
				ui.previewButton.MouseButton1Click:Connect(function()
					if myPreview then
						stopMyPreview()
						return
					end
					if activePreview then
						activePreview.stop() -- stop whichever other card was previewing
					end
					local rig = (jobRig and jobRig.Parent) and jobRig
						or (selectedRig and selectedRig.model)
					if not rig or not rig.Parent then
						setMessage("Select the rig in Workspace, then Preview.", C.warn)
						return
					end
					local ctrl, perr = Install.makePreview(rig, job.densePoses)
					if not ctrl then
						setMessage("Can't preview: " .. tostring(perr or "no data"), C.warn)
						return
					end
					myPreview = ctrl
					activePreview = ctrl
					ctrl.onFinished = stopMyPreview
					ctrl.play()
					ui.setPreviewText("Stop")
				end)

				local installed = false
				local function placeOnRig(manual)
					stopMyPreview() -- don't leave the rig frozen mid-pose when it gets a clip
					if not jobRig or not jobRig.Parent then
						ui.status.Text = "That rig is gone from Workspace — select a rig and use Install."
						ui.status.TextColor3 = C.warn
						ui.installButton.Visible = true
						return false
					end
					local kfs, ierr = Install.install(jobRig, job.densePoses, { jobId = jobId })
					if not kfs then
						ui.status.Text = "Install failed: " .. tostring(ierr)
						ui.status.TextColor3 = C.bad
						ui.installButton.Visible = true
						return false
					end
					if not installed then
						installed = true
						pendingInstalls = math.max(0, pendingInstalls - 1)
						task.spawn(function()
							api.installed(jobId)
							refreshEntitlement()
						end)
					end
					ui.installButton.Visible = false
					ui.status.Text = ('✓  On %s   ·   %s   ·   %s'):format(jobRig.Name, shape, quality)
					ui.status.TextColor3 = if errs == 0 then C.good else C.text
					if manual then
						setMessage(('✓  Installed "%s" onto %s.'):format(kfs.Name, jobRig.Name), C.good)
					else
						setMessage(
							('✓  "%s" is on %s — press ▶ Preview to watch it right here, or describe a change below.'):format(
								kfs.Name,
								jobRig.Name
							),
							C.good
						)
					end
					refreshAnimList(kfs.Name)
					return true
				end

				-- The conversation this job belongs to just gained a version. Redraw
				-- that tree, and only if it is the one on screen: the user may have
				-- opened a different chat during the two minutes this took.
				local myRoot = jobRoot
				if myRoot and openChat == myRoot then
					task.spawn(function()
						-- The version that just landed becomes the new branch point, so
						-- the NEXT edit builds on it rather than re-editing its parent
						-- forever. A user deliberately reading an older branch is left
						-- alone — yanking the transcript out from under them mid-read is
						-- worse than making them click once.
						if chatSelected == nil or chatSelected == opts.parentJobId then
							if resetChatPath then
								resetChatPath()
							end
							chatSelected = jobId
						end
						openChatDetail(myRoot, true)
					end)
				end

				pendingInstalls += 1
				if not placeOnRig(false) then
					-- couldn't place it (rig gone): keep it claimable rather than lost
					ui.status.Text = ("✓  Ready   ·   %s   ·   %s"):format(shape, quality)
					ui.status.TextColor3 = C.text
					ui.installButton.Visible = true
				end

				ui.installButton.MouseButton1Click:Connect(function()
					placeOnRig(true)
				end)

				ui.refineButton.MouseButton1Click:Connect(function()
					local critique = ui.critiqueBox.Text
					if critique:gsub("%s", "") == "" then
						setMessage("Describe what should change first, then click Refine.", C.warn)
						return
					end
					-- This card may belong to a chat the user has since left. Refining
					-- from here means going back to ITS conversation, not grafting a
					-- version onto whichever room happens to be open.
					if myRoot and currentChatRoot ~= myRoot then
						setChatContext(myRoot, nil)
						task.spawn(function()
							openChatDetail(myRoot)
						end)
					end
					runJob({
						prompt = prompt,
						previousClip = job.clip,
						critique = critique,
						parentJobId = jobId,
					})
					ui.critiqueBox.Text = ""
				end)
				return
			end
		end
	end)
end

--- Point the Chat tab at a conversation (nil starts a fresh one).
function setChatContext(rootId, title)
	currentChatRoot = rootId
	if rootId then
		chatStarted = true
	end
	-- Everything below keys off chatStarted rather than rootId: a chat whose first
	-- generation is still in flight has no id yet, but it is emphatically not a new
	-- chat, and offering to start one there is the whole bug.
	chatHeaderLabel.Text = if chatStarted
		then "EDITING  ·  " .. string.upper(tostring(title or "this animation"))
		else "NEW CHAT"
	chatHeaderLabel.TextColor3 = if chatStarted then C.accent else C.dim
	-- example prompts are first-run inspiration; once a chat is under way they are
	-- just clutter over a conversation
	if chipsRow then
		chipsRow.Visible = not chatStarted
	end
	if refreshSourceList then
		refreshSourceList() -- only a new chat can choose what to start from
	end
	if renderGenerateButton then
		renderGenerateButton() -- it owns the placeholder and the button label
	end
	if syncJobCards then
		syncJobCards() -- only this conversation's generations belong on screen
	end
end

--- Clear the board and start a fresh conversation.
function startNewChat()
	-- the user moved: every in-flight closure now belongs to a previous room
	chatEpoch += 1
	chatStarted = false
	if resetChatPath then
		resetChatPath()
	end
	setChatContext(nil, nil)
	openChat = nil
	chatSelected = nil
	chatTreeCard.Visible = false
	editSelected = nil
	tweakOpen = false
	renderEditOptions()
	promptBox.Text = ""
	-- Clear away FINISHED cards only. A generation still running belongs to the
	-- chat that started it: destroying its card orphaned the poll loop — no
	-- progress, no cancel, no way to install the result — while the job kept
	-- running and kept the composer locked. pendingInstalls is likewise shared
	-- across chats, so zeroing it here discarded results the user had paid for.
	-- Finished cards are thrown away; running ones survive but belong to the
	-- conversation that started them, so syncJobCards (via setChatContext above)
	-- hides them here. A new chat is genuinely empty.
	for _, c in ipairs(jobListFrame:GetChildren()) do
		if not c:IsA("UIListLayout") and c:GetAttribute("afRunning") ~= true then
			c:Destroy()
		end
	end
	syncJobCards()
	setMessage("")
	refreshEntitlement()
end

generateButton.MouseButton1Click:Connect(function()
	-- Inside an open conversation the composer CONTINUES it: what you type is the
	-- next change, branching from the newest version. That is what sending a
	-- message means here. A new chat generates from scratch instead.
	if chatStarted then
		-- This chat is still generating. There is nothing to edit yet, so the
		-- composer simply does not take the message — same as waiting for a reply.
		if chatIsBusy() then
			setMessage("Still generating — you can edit it as soon as it lands.", C.warn)
			return
		end
		local critique = promptBox.Text
		if critique:gsub("%s", "") == "" then
			setMessage("Describe what should change, then send.", C.warn)
			return
		end
		local rootId = currentChatRoot
		local sendEpoch = chatEpoch
		-- Branch from the message the user actually picked. Without this the
		-- stepper arrows and the "continues from vN" label were decoration: every
		-- edit hung off the newest version whatever the transcript said.
		local pickedId = chatSelected
		setMessage("Reading the animation…")
		task.spawn(function()
			local lineage = api.lineage(rootId)
			if chatEpoch ~= sendEpoch then
				return -- moved rooms mid-read; this message is not theirs any more
			end
			local newest = lineage and lineage.versions and lineage.versions[#lineage.versions]
			if pickedId and lineage and lineage.versions then
				for _, v in ipairs(lineage.versions) do
					if v.jobId == pickedId then
						newest = v
					end
				end
			end
			if not newest then
				setMessage(
					"The first version is still generating — it'll be ready shortly, then you can edit it.",
					C.warn
				)
				return
			end
			local job = api.job(newest.jobId)
			if not job or not job.clip then
				setMessage("Couldn't read the latest version — try again.", C.bad)
				return
			end
			if chatEpoch ~= sendEpoch then
				return
			end
			setMessage("")
			promptBox.Text = ""
			runJob({
				prompt = job.prompt or "improve this animation as described",
				previousClip = job.clip,
				critique = critique,
				parentJobId = newest.jobId,
			})
		end)
		return
	end
	-- Starting from an animation the rig already has: the message is a change to
	-- it, not a new idea. A clip this plugin made carries its job id, so we
	-- continue THAT conversation; anything else (hand-made, imported, from
	-- another tool) is read back off its keyframes to seed a new one.
	if sourceSelected then
		local entry = sourceSelected
		local rigModel = selectedRig and selectedRig.model
		local rigType = selectedRig and selectedRig.rigType
		local critique = promptBox.Text
		if critique:gsub("%s", "") == "" then
			setMessage(('Describe what should change about "%s".'):format(entry.name), C.warn)
			return
		end
		if not rigModel or not rigModel.Parent then
			setMessage("Pick a character first.", C.bad)
			return
		end
		setMessage(('Reading "%s"…'):format(entry.name))
		task.spawn(function()
			local previousClip, sourcePrompt
			local parentJobId = entry.meta and entry.meta.jobId or nil
			if parentJobId then
				local job = api.job(parentJobId)
				if job and job.clip then
					previousClip = job.clip
					sourcePrompt = job.prompt
				else
					parentJobId = nil -- the chat is gone; treat it as a fresh start
				end
			end
			if not previousClip then
				local extracted, xerr = Install.extractClip(rigModel, entry.kfs, rigType)
				if not extracted then
					setMessage(('Can\'t start from "%s": %s'):format(entry.name, tostring(xerr)), C.bad)
					return
				end
				previousClip = extracted
			end
			setMessage("")
			promptBox.Text = ""
			runJob({
				prompt = sourcePrompt or ('improve the animation "%s" as described'):format(entry.name),
				previousClip = previousClip,
				critique = critique,
				parentJobId = parentJobId,
			})
		end)
		return
	end

	runJob({ prompt = promptBox.Text })
end)

---------------------------------------------------------------- lifecycle
-- Leaving Studio in select mode with a SelectionBox parented to CoreGui is a
-- mess the user cannot clear themselves: the crosshair cursor and the highlight
-- outlive the window that created them, and the mouse.Move handler keeps walking
-- every descendant of whatever they hover. Tear down on both exits.
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	if not widget.Enabled then
		stopPicking()
	elseif connLabel.Text ~= "● connected" and startConnectionWatch then
		-- reopening the dock should retry a sleeping server right away
		startConnectionWatch()
	end
end)

plugin.Unloading:Connect(function()
	stopPicking()
	if highlightBox then
		highlightBox:Destroy()
		highlightBox = nil
	end
	-- don't leave generations running that nobody is waiting for
	for jobId, state in pairs(activeJobs) do
		if not state.cancelled then
			state.cancelled = true
			local id = jobId
			task.spawn(function()
				api.cancel(id)
			end)
		end
	end
end)

---------------------------------------------------------------- boot
selectTab("Chat")
setChatContext(nil, nil)
applyConsentGate()

-- Keep trying to reach the server on a backoff while we're not connected and the
-- dock is open, instead of the old single retry that gave up after 4s — which,
-- against a cold-starting Railway container, left the plugin permanently "offline"
-- until the user happened to switch tabs.
function startConnectionWatch()
	if connectWatchRunning then
		return
	end
	connectWatchRunning = true
	task.spawn(function()
		local delays = { 3, 5, 10, 20 }
		local i = 0
		while widget.Enabled and connLabel.Text ~= "● connected" do
			refreshEntitlement()
			i += 1
			task.wait(delays[math.min(i, #delays)])
		end
		connectWatchRunning = false
	end)
end
startConnectionWatch()
