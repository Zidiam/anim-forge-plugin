--- Show which size is picked, what each costs, and which ones the balance covers.
function renderQuality()
	local unlimited = affordableCredits ~= nil and affordableCredits < 0
	for q, b in pairs(segButtons) do
		local on = model == q
		local cost = qualityCost[q] or 1
		local afford = affordableCredits == nil or unlimited or cost <= affordableCredits
		b.BackgroundColor3 = if on then C.accent else C.field
		-- dim an unaffordable size to red so the picker never sets the user up to
		-- click something the server will refuse
		b.TextColor3 = if on then C.onAccent elseif afford then C.dim else C.bad
		b.Text = ("%s · %s"):format(QUALITY_LABEL[q], fmtCredits(cost) .. (cost == 1 and " credit" or " credits"))
	end
	local cost = qualityCost[model] or 1
	if affordableCredits ~= nil and not unlimited and cost > affordableCredits then
		segCaption.Text = ("%s needs %s credit%s — you have %s. Pick a smaller size, or top up from the Anim Forge experience — link in Settings."):format(
			QUALITY_LABEL[model],
			fmtCredits(cost),
			cost == 1 and "" or "s",
			fmtCredits(math.max(0, affordableCredits))
		)
		segCaption.TextColor3 = C.warn or C.bad
	else
		segCaption.Text = QUALITY_BLURB[model] or ""
		segCaption.TextColor3 = C.dim
	end
end

--- Adopt the server's credit costs, so they can change without a plugin release.
function applyQualityCosts(costs)
	if type(costs) ~= "table" then
		return
	end
	for _, q in ipairs(QUALITIES) do
		local v = tonumber(costs[q])
		if v then
			qualityCost[q] = v
		end
	end
	renderQuality()
end

