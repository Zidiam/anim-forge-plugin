---------------------------------------------------------------- picking machinery
local onRigSelected -- fwd decl (Edit tab refreshes its animation list)

--- Resolve a clicked/selected instance to a selectable rig.
--- Returns (model) when animatable, or (nil, reason) when it must not be selected:
--- not a model, not rigged (no joints), or a skeleton we can't animate yet.
--- Type detection (R15/R6/custom) is internal — never shown to the user.
local function resolveRig(instance)
	local node = instance
	while node and node ~= workspace do
		if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
			local hasJoint = false
			for _, d in ipairs(node:GetDescendants()) do
				if d:IsA("Motor6D") or d:IsA("AnimationConstraint") then
					hasJoint = true
					break
				end
			end
			if not hasJoint then
				return nil, ('"%s" isn\'t rigged — it has no joints to animate.'):format(node.Name)
			end
			local rigType = Descriptor.classify(node)
			if rigType ~= "R15" and rigType ~= "R6" then
				return nil, ('"%s" isn\'t ready to be animated here yet — use a standard Roblox character.'):format(node.Name)
			end
			local desc = Descriptor.describe(node)
			if not desc then
				return nil, ('"%s" isn\'t ready to be animated — its rig couldn\'t be read.'):format(node.Name)
			end
			return node
		end
		node = node.Parent
	end
	return nil, nil -- not a character at all; no message on hover, gentle one on click
end

local function showRig(model)
	selectedRig = { model = model, rigType = Descriptor.classify(model) }
	rigHint.Text = ""
	renderSlots("selected")
	for _, s in ipairs(slots) do
		s.stroke.Color = C.good -- brief green flash so the lock-in is unmissable
	end
	task.delay(0.8, function()
		if not picking then
			for _, s in ipairs(slots) do
				s.stroke.Color = C.stroke
			end
		end
	end)
	if onRigSelected then
		onRigSelected()
	end
end

local function setHighlight(model)
	if highlightBox then
		highlightBox.Adornee = model
		highlightBox.Parent = model and CoreGui or nil
	end
end

local function stopPicking()
	if not picking then
		return
	end
	picking = false
	for _, c in ipairs(pickConns) do
		c:Disconnect()
	end
	pickConns = {}
	if highlightBox then
		highlightBox:Destroy()
		highlightBox = nil
	end
	pcall(function()
		plugin:Deactivate()
	end)
	renderSlots(selectedRig and "selected" or "empty")
end

function startPicking()
	if picking then
		stopPicking()
		return
	end
	picking = true
	rigHint.Text = ""
	renderSlots("armed")

	-- soft pulse on the slot borders while armed
	task.spawn(function()
		local t = 0
		while picking do
			t += task.wait(0.05)
			local a = 0.1 + 0.45 * (0.5 + 0.5 * math.sin(t * 5))
			for _, s in ipairs(slots) do
				s.stroke.Transparency = a
			end
		end
		for _, s in ipairs(slots) do
			s.stroke.Transparency = 0
		end
	end)

	highlightBox = Instance.new("SelectionBox")
	highlightBox.Name = "AnimForgePickHighlight"
	highlightBox.Color3 = C.accent
	highlightBox.SurfaceTransparency = 0.85
	highlightBox.SurfaceColor3 = C.accent
	highlightBox.LineThickness = 0.03

	plugin:Activate(true)
	local mouse = plugin:GetMouse()
	mouse.Icon = "rbxasset://SystemCursors/Cross"

	table.insert(
		pickConns,
		mouse.Move:Connect(function()
			-- only VALID rigs light up; unselectable things get no highlight at all
			local rig = mouse.Target and resolveRig(mouse.Target) or nil
			setHighlight(rig)
			if picking then
				setSlotSub(rig and ('Click to select "%s"'):format(rig.Name) or ARMED_SUB)
			end
		end)
	)
	table.insert(
		pickConns,
		mouse.Button1Down:Connect(function()
			local rig, reason = resolveRig(mouse.Target)
			if rig then
				showRig(rig)
				Selection:Set({ rig })
				stopPicking()
			else
				rigHint.Text = reason
					or "That isn't a character — click a rigged model (it highlights when you hover it)."
				rigHint.TextColor3 = C.warn
			end
		end)
	)
	table.insert(
		pickConns,
		Selection.SelectionChanged:Connect(function()
			local sel = Selection:Get()[1]
			if not sel then
				return
			end
			local rig, reason = resolveRig(sel)
			if rig then
				showRig(rig)
				stopPicking()
			elseif reason then
				-- they explicitly clicked something un-animatable in the Explorer: say why,
				-- stay armed so they can pick again
				rigHint.Text = reason
				rigHint.TextColor3 = C.warn
			end
		end)
	)
	table.insert(
		pickConns,
		plugin.Deactivation:Connect(function()
			stopPicking()
		end)
	)
end

