--- Entitlement is never version-gated (an outdated install has to be able to
--- learn that it is outdated), so the live address usually does reach this
--- screen before anyone reads it.
function setUpdateUrl(url)
	if type(url) == "string" and url ~= "" then
		updateUrlBox.Text = url
	end
